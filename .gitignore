# Môi trường và bí mật
.env
venv/
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.idea/
.vscode/

# Dữ liệu nặng, giữ lại thư mục
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/final/*
!data/final/.gitkeep
*.jsonl.gz
*.parquet
*.csv
!data/sample/*.csv
*.db
*.sqlite3

# Log và mô hình
logs/*.log
!logs/.gitkeep
*.pkl
*.joblib
